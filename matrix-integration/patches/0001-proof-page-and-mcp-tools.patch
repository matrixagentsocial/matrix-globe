@@ -0,0 +1,122 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+
+import { MCP_TOOLS_BY_NAME } from './mcp-tools';
+import {
+  PROOFDESK_SLUG,
+  canonicalJson,
+  extractCertificate,
+  formatProofRequest,
+  readProofThread,
+  sha256Hex,
+  summarizeProofThread,
+  verifyCertificate,
+} from './proof';
+
+// Generated by the Python desk (proof/bundle.py canonical_json + sha256_of).
+const fixture = JSON.parse(readFileSync(new URL('./fixtures/proof-bundle.json', import.meta.url), 'utf8')) as {
+  bundle: Record<string, unknown>;
+  canonical: string;
+  sha256: string;
+};
+
+const certificateBody = (bundle: unknown, sha: string) =>
+  `**Certificate: VERIFIED**\n\n\`\`\`matrix-proof\n${canonicalJson(bundle)}\n\`\`\`\nsha256: ${sha}\n`;
+
+test('canonicalJson is byte-identical to the Python desk', async () => {
+  assert.equal(canonicalJson(fixture.bundle), fixture.canonical);
+  assert.equal(await sha256Hex(fixture.canonical), fixture.sha256);
+});
+
+test('certificate round trip verifies, tampering does not', async () => {
+  const cert = extractCertificate(certificateBody(fixture.bundle, fixture.sha256));
+  assert.ok(cert);
+  assert.equal(cert.sha256, fixture.sha256);
+  assert.deepEqual(await verifyCertificate(cert), { stated: fixture.sha256, computed: fixture.sha256, matches: true });
+
+  const tampered = extractCertificate(certificateBody({ ...fixture.bundle, status: 'VERIFIED ' }, fixture.sha256));
+  assert.ok(tampered);
+  assert.equal((await verifyCertificate(tampered)).matches, false);
+});
+
+test('formatProofRequest uses the desk sections', () => {
+  const body = formatProofRequest({ spec: 'Split an amount.', code: 'def f():\n    pass\n\n', tests: 'def test_x():\n    pass' });
+  assert.match(body, /^## Spec\nSplit an amount\.\n\n## Code\n```python\ndef f\(\):\n    pass\n```\n\n## Tests \(optional\)\n```python\n/);
+  assert.doesNotMatch(formatProofRequest({ spec: 's', code: 'c' }), /## Tests/);
+});
+
+const desk = { slug: PROOFDESK_SLUG, name: 'proofdesk' };
+const author = { slug: 'proof-builder', name: 'proof-builder' };
+
+function creationWithThread(withCertificate: boolean) {
+  return {
+    id: 'creation-1',
+    title: 'Proof request: split installments',
+    reviews: [
+      { id: 'other', body: 'nice', agent: { slug: 'someone' }, createdAt: '2026-10-30T10:00:00Z', replies: [] },
+      {
+        id: 'review-1',
+        body: '2 claims proven',
+        reviewType: 'BUG_REPORT',
+        codeSuggestion: 'def test_c1():\n    assert False\n',
+        agent: desk,
+        createdAt: '2026-10-30T10:05:00Z',
+        replies: [
+          { id: 'rev-1', body: 'Verified revision', codeSuggestion: 'def split():\n    return []\n', agent: author, createdAt: '2026-10-30T10:06:00Z' },
+          ...(withCertificate
+            ? [{ id: 'cert-1', body: certificateBody(fixture.bundle, fixture.sha256), agent: desk, createdAt: '2026-10-30T10:07:00Z' }]
+            : []),
+        ],
+      },
+    ],
+  };
+}
+
+test('readProofThread finds the desk review, revision and certificate', () => {
+  const thread = readProofThread(creationWithThread(true));
+  assert.equal(thread.status, 'verified');
+  assert.equal(thread.review?.id, 'review-1');
+  assert.equal(thread.revision?.id, 'rev-1');
+  assert.equal(thread.certificateReview?.id, 'cert-1');
+  assert.deepEqual(thread.claims.map((c) => [c.id, c.status, c.validity]), [
+    ['C1', 'PROVEN', 'VALID'],
+    ['C2', 'UNPROVEN', null],
+  ]);
+
+  assert.equal(readProofThread(creationWithThread(false)).status, 'reviewed');
+  assert.equal(readProofThread({ id: 'x', reviews: [] }).status, 'pending');
+});
+
+test('request_proof builds a tagged public CODE creation', () => {
+  const tool = MCP_TOOLS_BY_NAME.get('request_proof');
+  assert.ok(tool);
+  const attribution = { provider: 'meta', model: 'muse-wonder-1.0', agent: 'Muse Code' };
+  const request = tool.build({ spec: '# Split 100.00 in 3\nRules...', code: 'def split(): ...', attribution });
+  const body = request.body as Record<string, any>;
+  assert.equal(request.path, '/v1/creations');
+  assert.equal(body.title, 'Proof request: Split 100.00 in 3');
+  assert.equal(body.category, 'CODE');
+  assert.equal(body.visibility, 'public');
+  assert.deepEqual(body.tags.slice(0, 1), ['proof-request']);
+  assert.match(body.description, /@proofdesk/);
+  assert.deepEqual(body.attribution, attribution);
+  assert.deepEqual(tool.transform?.({ id: 'abc' }), {
+    creationId: 'abc',
+    proofUrl: 'https://matrixagentnet.com/proof?id=abc',
+    expectedWithinMinutes: 30,
+    next: 'Call get_proof with this creationId to read the proven defects, the revision and the certificate.',
+  });
+});
+
+test('get_proof summarizes the thread for a model', () => {
+  const tool = MCP_TOOLS_BY_NAME.get('get_proof');
+  assert.ok(tool);
+  assert.equal(tool.auth, false);
+  assert.equal(tool.build({ creationId: 'creation-1' }).path, '/v1/creations/creation-1');
+  const summary = summarizeProofThread(creationWithThread(true));
+  assert.equal(summary.status, 'verified');
+  assert.equal(summary.certificate?.sha256, fixture.sha256);
+  assert.equal(summary.revisedCode, 'def split():\n    return []\n');
+  assert.equal(summary.proofUrl, 'https://matrixagentnet.com/proof?id=creation-1');
+});
